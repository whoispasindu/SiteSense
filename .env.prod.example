# Settings for docker-compose.prod.yml. The setup script writes this file for you, with strong secrets:
#
#   python scripts/setup.py            (python setup.py in the release bundle; see docs/self-hosting.md)
#
# By hand: copy to .env.prod (git-ignored), replace every value, then
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Generate each secret separately, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start in production with the example values ("change-me") below.

# Where it is served. "localhost" for a local run (Caddy's own certificate); your domain on a server.
SITESENSE_DOMAIN=localhost
# "internal" for localhost. On a server: your email address, and Caddy gets a Let's Encrypt
# certificate for SITESENSE_DOMAIN (the domain must point at the server).
SITESENSE_TLS=internal
# 127.0.0.1: reachable from this machine only. On a server: 0.0.0.0 (ports 80 and 443 open).
SITESENSE_BIND=127.0.0.1

# --- Which release ---------------------------------------------------------------------------------------
# The images to run, from GitHub Container Registry. Upgrading is changing this and running
# `docker compose ... pull && docker compose ... up -d` (back up first: migrations run on start).
SITESENSE_VERSION=latest
SITESENSE_IMAGE_PREFIX=ghcr.io/whoispasindu/sitesense

# --- Database (the three passwords must all differ) ---------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres-superuser
SITESENSE_OWNER_PASSWORD=change-me-schema-owner
SITESENSE_APP_PASSWORD=change-me-runtime-app

# --- Secrets (32+ characters each, all different) ----------------------------------------------------
SITESENSE_JWT_SECRET=change-me-jwt-secret-0000000000000000000000
SITESENSE_MFA_KEY=change-me-mfa-key-000000000000000000000000000

# --- Your company's country, time zone and currency ---------------------------------------------------
# Set these before the first project. Amounts are never converted: changing the currency later only
# relabels them. Changing the time zone needs a restart (it moves "today" and every scheduled job).
SITESENSE_COUNTRY=LK
SITESENSE_TIME_ZONE=Asia/Colombo
SITESENSE_CURRENCY=LKR
SITESENSE_NUMBER_LOCALE=en-LK
# Only when the currency is not LKR: how many Sri Lankan rupees one unit of your currency is worth.
# The risk model was trained on contract values in LKR; this converts them for the model only.
# Example for a company in the United Kingdom: COUNTRY=GB, TIME_ZONE=Europe/London, CURRENCY=GBP,
# NUMBER_LOCALE=en-GB, RISK_LKR_PER_UNIT=400
SITESENSE_RISK_LKR_PER_UNIT=

# --- Demo mode -----------------------------------------------------------------------------------------
# true: seed the demo with `docker compose -f docker-compose.prod.yml --env-file .env.prod run --rm
# backend python -m app.cli seed-dev`; the demo accounts skip two-step codes, emails are only logged,
# a banner says it is demo data, and the data resets every night at 03:00 (needs the URL below).
# Never true for a real company.
SITESENSE_DEMO_MODE=true
SITESENSE_DEMO_PASSWORD=SiteSense-Demo-2026!
# Demo only: the nightly reset runs as the schema owner. Use SITESENSE_OWNER_PASSWORD from above.
# Leave empty when demo mode is off, so no running process holds the owner password.
SITESENSE_DEMO_RESET_DATABASE_URL=postgresql+psycopg://sitesense_owner:change-me-schema-owner@db:5432/sitesense

# --- Optional ------------------------------------------------------------------------------------------
# Uvicorn worker processes for the API.
WEB_CONCURRENCY=4
# The AI briefing (otherwise rule-based). Give the key a monthly spending limit in the Claude Console.
SITESENSE_ANTHROPIC_API_KEY=
# Email (otherwise written to the log; always only logged in demo mode).
SITESENSE_SMTP_HOST=
SITESENSE_SMTP_PORT=587
SITESENSE_SMTP_SECURITY=starttls
SITESENSE_SMTP_USERNAME=
SITESENSE_SMTP_PASSWORD=
SITESENSE_EMAIL_FROM=SiteSense <no-reply@example.com>
