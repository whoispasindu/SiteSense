# Settings for docker-compose.prod.yml. Copy to .env.prod (git-ignored) and replace every value.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Generate each secret separately, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start in production with the example values ("change-me") below.

# Where it is served. "localhost" for a local run (Caddy's own certificate); your domain on a server.
SITESENSE_DOMAIN=localhost

# --- Database (the three passwords must all differ) ---------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres-superuser
SITESENSE_OWNER_PASSWORD=change-me-schema-owner
SITESENSE_APP_PASSWORD=change-me-runtime-app

# --- Secrets (32+ characters each, all different) ----------------------------------------------------
SITESENSE_JWT_SECRET=change-me-jwt-secret-0000000000000000000000
SITESENSE_MFA_KEY=change-me-mfa-key-000000000000000000000000000

# --- Demo mode -----------------------------------------------------------------------------------------
# true: seed the demo with `docker compose -f docker-compose.prod.yml --env-file .env.prod run --rm
# backend python -m app.cli seed-dev`; the demo accounts skip two-step codes, emails are only logged,
# a banner says it is demo data, and the data resets every night at 03:00 (needs the URL below).
# Never true for a real company.
SITESENSE_DEMO_MODE=true
SITESENSE_DEMO_PASSWORD=SiteSense-Demo-2026!
# Demo only: the nightly reset runs as the schema owner. Use SITESENSE_OWNER_PASSWORD from above.
# Leave empty when demo mode is off, so no running process holds the owner password.
SITESENSE_DEMO_RESET_DATABASE_URL=postgresql+psycopg://sitesense_owner:change-me-schema-owner@db:5432/sitesense

# --- Optional ------------------------------------------------------------------------------------------
# Uvicorn worker processes for the API.
WEB_CONCURRENCY=4
# The AI briefing (otherwise rule-based). Give the key a monthly spending limit in the Claude Console.
SITESENSE_ANTHROPIC_API_KEY=
# Email (otherwise written to the log; always only logged in demo mode).
SITESENSE_SMTP_HOST=
SITESENSE_SMTP_USERNAME=
SITESENSE_SMTP_PASSWORD=
SITESENSE_EMAIL_FROM=SiteSense <no-reply@example.com>
