# Copy to backend/.env for running the API outside Docker. Never commit the real .env.
SITESENSE_ENVIRONMENT=development
SITESENSE_LOG_LEVEL=INFO
# Runtime role: data read/write only, cannot change the schema.
SITESENSE_DATABASE_URL=postgresql+psycopg://sitesense_app:change-me-app@127.0.0.1:5432/sitesense
# Migration role: owns the schema. Used only by Alembic.
SITESENSE_MIGRATION_DATABASE_URL=postgresql+psycopg://sitesense_owner:change-me-owner@127.0.0.1:5432/sitesense
SITESENSE_CORS_ORIGINS=http://localhost:5173
SITESENSE_ALLOWED_HOSTS=localhost,127.0.0.1,backend
