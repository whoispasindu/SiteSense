# Copy to backend/.env for running the API outside Docker. Never commit the real .env.
SITESENSE_ENVIRONMENT=development
SITESENSE_LOG_LEVEL=INFO
# Runtime role: data read/write only, cannot change the schema.
SITESENSE_DATABASE_URL=postgresql+psycopg://sitesense_app:change-me-app@127.0.0.1:5432/sitesense
# Migration role: owns the schema. Used only by Alembic.
SITESENSE_MIGRATION_DATABASE_URL=postgresql+psycopg://sitesense_owner:change-me-owner@127.0.0.1:5432/sitesense
SITESENSE_CORS_ORIGINS=http://localhost:5173
SITESENSE_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Access-token signing key (32+ chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SITESENSE_JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0000000000
# Password for the demo accounts created by `python -m app.cli seed-dev` (local only).
SITESENSE_DEMO_PASSWORD=SiteSense-Demo-2026!

# --- Daily briefing (Phase 11) ---------------------------------------------------------------------
# Optional. Without a key everyone gets the rule-based briefing. Only structured facts are sent
# (scores, ranges, counts, project codes and names, rule IDs), never report text or people's names.
# SITESENSE_ANTHROPIC_API_KEY=sk-ant-...
# SITESENSE_BRIEFING_MODEL=claude-haiku-5-5

# --- Email (Phase 11) --------------------------------------------------------------------------------
# Optional. Without an SMTP host, emails are written to the server log instead of sent.
# SITESENSE_SMTP_HOST=smtp.example.com
# SITESENSE_SMTP_PORT=587
# SITESENSE_SMTP_SECURITY=starttls
# SITESENSE_SMTP_USERNAME=
# SITESENSE_SMTP_PASSWORD=
# SITESENSE_EMAIL_FROM=SiteSense <no-reply@example.com>
# Links in emails open the app here (https in production).
SITESENSE_APP_BASE_URL=http://localhost:5173
