# Production front door (docker-compose.prod.yml): HTTPS on one origin, the built web app at /,
# and the API under /api, so the refresh cookie stays same-site (SameSite=Strict).
#
# Locally (SITESENSE_TLS=internal, the default), Caddy issues a certificate from its own CA; the
# browser warns once until you trust it. On a real server, set SITESENSE_DOMAIN to your domain and
# SITESENSE_TLS to an email address: Caddy gets a Let's Encrypt certificate by itself (the domain must
# point at the server, and ports 80 and 443 must be reachable: SITESENSE_BIND=0.0.0.0).
#
# Caddy trusts no forwarded headers: it always replaces X-Forwarded-For with the address that
# connected to it, so nobody can choose the IP that sign-in limits and the audit log see. Only if
# another proxy or load balancer sits in front of Caddy, trust that one address in the global block:
#   servers {
#   	trusted_proxies static 10.0.0.5/32
#   }
{
	admin off
}

{$SITESENSE_DOMAIN:localhost} {
	tls {$SITESENSE_TLS:internal}
	encode zstd gzip

	# The largest accepted request is a 10 MB photo or a BOQ upload; refuse anything bigger here.
	request_body {
		max_size 12MB
	}

	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		reverse_proxy frontend:8080
	}

	header -Server
}
