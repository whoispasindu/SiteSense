# Secrets: never commit real environment files
.env
.env.*
!.env.example
!.env.prod.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node
node_modules/
dist/
coverage/

# ML artefacts: large files go to GitHub Releases, not git
ml/data/
ml/models/*.joblib
ml/models/*.pkl
*.ipynb_checkpoints

# Uploads and local storage
storage/
uploads/
backend/var/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local Claude Code launch configs
.claude/

# Local profiling and backup files
prof/
*.bak
*.cpuprofile

# Transformer weights and tokenizers stay out of git (GitHub Release or Git LFS if they ship)
ml/models/report-nlp/distilbert/
*.safetensors
*.onnx
ml/models/report-nlp/onnx/
backend/app/ai/nlp/models/report-issues-category/
