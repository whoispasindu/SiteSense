# Optional overrides for docker compose. Copy to .env (git-ignored) and change the values.
# The defaults are fine for local development only; never reuse them anywhere public.
POSTGRES_PASSWORD=change-me-postgres
SITESENSE_OWNER_PASSWORD=change-me-owner
SITESENSE_APP_PASSWORD=change-me-app
# Access-token signing key for the API (32+ characters).
SITESENSE_JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0000000000
# Password for the demo accounts created by `docker compose exec backend python -m app.cli seed-dev`.
SITESENSE_DEMO_PASSWORD=SiteSense-Demo-2026!
# --- Your company's country, time zone and currency ---------------------------------------------------
# Set these before the first project. Amounts are never converted: changing the currency later only
# relabels them. Changing the time zone needs a restart (it moves "today" and every scheduled job).
SITESENSE_COUNTRY=LK
SITESENSE_TIME_ZONE=Asia/Colombo
SITESENSE_CURRENCY=LKR
SITESENSE_NUMBER_LOCALE=en-LK
# Only when the currency is not LKR: how many Sri Lankan rupees one unit of your currency is worth.
# The risk model was trained on contract values in LKR; this converts them for the model only.
# Example for a company in the United Kingdom: COUNTRY=GB, TIME_ZONE=Europe/London, CURRENCY=GBP,
# NUMBER_LOCALE=en-GB, RISK_LKR_PER_UNIT=400
SITESENSE_RISK_LKR_PER_UNIT=
# Live weather from Open-Meteo (free, no key). Set to false to work offline with cached forecasts.
SITESENSE_WEATHER_ENABLED=true
